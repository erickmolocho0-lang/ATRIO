{
  "expo": {
    "name": "ATRIO",
    "slug": "atrio",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "atrio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atrio.app"
    },
    "android": {
      "package": "com.atrio.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "ATRIO necesita acceder a tus fotos para que elijas la imagen de un producto."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
