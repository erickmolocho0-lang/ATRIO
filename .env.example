# Copia este archivo con el nombre .env y completa los valores.
# Los valores reales se entregan por un canal privado; nunca se suben al repositorio.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MP_PUBLIC_KEY=

# OPENAI_API_KEY, OPENAI_MODEL, MP_ACCESS_TOKEN, MP_ACCESS_TOKEN_YAPE y
# MP_WEBHOOK_SECRET NO van en este archivo: son secretos del servidor y se
# configuran en Supabase (Edge Functions > Secrets). Ver el README.
